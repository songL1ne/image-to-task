# ── LLM Providers ──────────────────────────────────────────────────────────────
# Set the key for whichever provider you configure in config.yaml.

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# IBM watsonx.ai
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Task Destinations ──────────────────────────────────────────────────────────

# Todoist personal API token (Settings → Integrations → Developer)
TODOIST_API_TOKEN=

# Notion internal integration token (notion.so/my-integrations)
NOTION_TOKEN=
# The ID of the Notion database to write tasks into
# (found in the database URL: notion.so/<workspace>/<DATABASE_ID>?v=...)
NOTION_DATABASE_ID=
